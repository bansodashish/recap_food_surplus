# Production Environment Configuration

# AWS S3 Configuration (REQUIRED for photo uploads)
VITE_AWS_ACCESS_KEY_ID=your_production_aws_access_key_here
VITE_AWS_SECRET_ACCESS_KEY=your_production_aws_secret_key_here
VITE_AWS_REGION=eu-west-1
VITE_S3_BUCKET=bansoash-poc

# AWS Cognito Configuration
VITE_AWS_PROJECT_REGION=eu-west-1
VITE_AWS_COGNITO_REGION=eu-west-1
VITE_AWS_USER_POOLS_ID=eu-west-1_In6BAFcN1
VITE_AWS_USER_POOLS_WEB_CLIENT_ID=1sh3gt6g7eupf69i8c1ht8ang0

# API Configuration
VITE_API_BASE_URL=https://your-production-api-gateway-url.execute-api.eu-west-1.amazonaws.com/prod

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_stripe_publishable_key_here

# Application Configuration
VITE_APP_NAME=Recap Food Surplus
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production

# Security & Performance
VITE_ENABLE_DEBUG=false
VITE_MAX_UPLOAD_SIZE=10485760
VITE_MAX_PHOTOS_PER_ITEM=5
